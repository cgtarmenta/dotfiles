{
    "hyprland/workspaces": {
        "disable-scroll": true,
        "active-only": false,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{name}{icon}{windows}",
        "format-icons": {
            "urgent": "  ",
            "default": " ",
            "empty": ""
        },
        "window-rewrite": {
            "title<.*youtube.*>": " ",
            "(.*) - Google Chrome": " ",
            "(.*)Code-OSS": "󰨞 ",
            "class<code-oss>": "󰨞 ",
            "(.*) - Nautilus": " ",
            "class<discord>": " ",
            "Steam": " ",
            "class<org.telegram.desktop>": " ",
            "WhatsDesk": " ",
            "Warp": " ",
            "class<spotify>": " ",
            "class<notion>": " ", // TODO add notion's symbol icon
            "class<unityhub>": " ",
            "class<Unity>": " ",
            "class<zenity>": " ",
            "class<MuPDF>": " "
        }
        // "persistent-workspaces" lives in config.jsonc: the full bar pins all
        // ten numbers, the laptop's compact bar shows only the ones in use.
    },

    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            "(.*) - Google Chrome": " $1",
            "(.*) - Code-OSS": "󰨞 $1",
            "(.*) - Nautilus": " $1",
            "(.*) - Discord": " $1",
            "Unity - (.*)": " $1",
            "Steam": " Steam",
            "WhatsDesk": " WhatsDesk",
            "Warp": "  $1",
            "class<org.telegram.desktop>": " $1",
            "class<spotify>": " Spotify",
            "class<unityhub>": " UnityHub",
            "class<zenity>": "  Lenovo Vantage"
        },
        "icon": true,
        "separate-output": true
    },

    // Groups are module definitions too, so both bars share them from here and
    // only name "group/<...>" in their own modules-* lists.
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "power-profiles-daemon",
            "custom/ac_idle_mode",
            "custom/wl-gammarelay-temperature",
            "backlight"
        ]
    },

    "group/audio": {
        "orientation": "horizontal",
        "modules": [
            "wireplumber",
            "pulseaudio#microphone"
        ]
    },

    "group/exit": {
        "orientation": "horizontal",
        "modules": [
            "custom/power_btn",
            "custom/lock_screen"
        ]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "locale": "es_ES.UTF-8",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format-alt": "{:L%a %d/%m/%y (%H:%M:%S)}",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },

    "backlight": {
        // No "device" set: Waybar auto-picks the available backlight device.
        // on-scroll commands restricted to the "backlight" *class*
        // specifically: without it, a bare `brightnessctl set` on a machine
        // with no real backlight falls back to the first device of *any*
        // class — which was the keyboard's caps lock LED here, so scrolling
        // this widget toggled Caps Lock instead of doing nothing.
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl --class=backlight set 1%+",
        "on-scroll-down": "brightnessctl --class=backlight set 1%-",
        "tooltip-format": "Brightness",
        "tooltip": true
    },

    "battery": {
        "states": {
            "good": 75,
            "warning": 35,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "tooltip": true,
        "format-muted": "",
        "on-click": "pamixer -t",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        }
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " ",
        "on-click": "pamixer --default-source -t",
        "on-scroll-up": "pamixer --default-source -i 5",
        "on-scroll-down": "pamixer --default-source -d 5",
        "scroll-step": 5
    },
    
    "temperature": {
        // No "thermal-zone"/"hwmon-path" here: the CPU sensor differs per
        // machine, so each bar in config.jsonc supplies its own.
        "interval": 5,
        "format": "{icon}  {temperatureC}°C",
        // Graduated thermometer: the fill rises with the temperature.
        // FontAwesome thermometer-empty..three-quarters (U+F2CB..F2C8);
        // the previous set used two Material Design codepoints that Nerd
        // Fonts v3 dropped, so two of the three steps rendered as tofu.
        "format-icons": ["", "", "", ""],
        "format-alt-click": "click-right",
        "critical-threshold": 80,
        "format-critical": " {temperatureC}°C",
        "on-click": "warp-terminal --title btop sh -c 'btop'",
        "tooltip-format": "CPU Temperature",
        "tooltip": true
    },

    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%)  ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname}: via {gwaddr} \n<small>down/up:  {bandwidthDownBytes}   {bandwidthUpBytes}</small>",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected 󰌙",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "interval": 1,
        "on-click": "wl-copy $(ip address show up scope global | grep inet | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c5-)",
        "on-click-right": "warp-terminal -e nmtui",
        "max-length": 30
    },

    "power-profiles-daemon": {
        "format": "{icon} ",
        "tooltip-format": "Power Profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
          "default": "",
          "performance": "",
          "balanced": "",
          "power-saver": ""
        }
    },

    "custom/asus_gpu_mode": {
        // Only shows on machines with supergfxctl (ASUS ROG hybrid-GPU
        // laptops); the script itself also degrades to "N/A" if the binary
        // is missing, but exec-if keeps it off the bar entirely elsewhere.
        "format": "󰢮 {}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/asus-gpu-mode.sh",
        "exec-if": "command -v supergfxctl",
        "interval": 10,
        "tooltip": true,
        "tooltip-format": "GPU Mode: {}"
    },

    "custom/monitor_brightness": {
        // Real hardware backlight for external monitors, via DDC/CI
        // (VCP 10) instead of the Linux "backlight" sysfs class, which
        // only covers internally-wired panels. exec/on-scroll-* are left
        // unset here on purpose: config.jsonc overrides them per bar with
        // the right --model/--sn selector for whichever monitor that bar
        // lives on, exactly like "temperature" already does for its sensor.
        "format": "󰃟 {}",
        "return-type": "json",
        "interval": 10,
        "tooltip": true
    },

    "custom/ac_idle_mode": {
        // Laptop-only AC no-idle toggle. Same supergfxctl gate as
        // custom/asus_gpu_mode keeps it off the desktop bar entirely.
        // hypridle (started laptop-only from hyprland.lua) routes its
        // lock/dpms/suspend timeouts through this script, which skips idle
        // actions while on AC power so the machine stays awake when plugged in.
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/ac-power-idle-toggle.sh status-json",
        "exec-if": "command -v supergfxctl",
        "interval": 2,
        "on-click": "~/.config/hypr/scripts/ac-power-idle-toggle.sh toggle",
        "tooltip": true
    },

    "custom/power_btn": {
        "format" : "{icon}",
        "format-icons": [""],
        //"on-click": "sh -c'(sleep 0.5s; wlogout --protocol layer-shell)' & disown",
        "on-click": "wlogout --protocol layer-shell",
        "tooltip-format": "Power Options",
        "tooltip": true
    },

    "custom/lock_screen": {
        "format": "{icon}",        
        "format-icons": [""],
        "on-click": "swaylock",
        "tooltip-format": "Lock Screen",
        "tooltip": true
    },

    "custom/updates": {
        //"format": " {}",
        "format": " {}",
        // "tooltip-format": "Update System\n<small>Packages: {}</small>",
        "escape": true,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/updates.sh",
        "restart-interval": 3600,
        "on-click": "warp-terminal --title Updates sh -c ~/.config/waybar/scripts/installaupdates.sh",
        "on-click-right": "warp-terminal --title 'Installed Packages' sh -c ~/.config/waybar/scripts/listpackages.sh",
        "tooltip": true
    },

    "custom/wol": {
        "format": "{icon}",
        "format-icons": [""],
        "tooltip-format": "Wake and Connect to Host:\n<small>{}</small>",
        "escape": true,
        "return-type":"json",
        "exec":"~/.config/waybar/scripts/tailscaleinfo.sh",
        "interval": 60,
        "on-click": "~/.config/waybar/scripts/wol.sh",
        "on-click-right": "warp-terminal --title 'Connect to '$(cat ~/.config/.secrets/hostname.txt)'' sh -c ~/.config/waybar/scripts/connectssh.sh",
        "tooltip": true
    },

    "custom/swaync": {
        "format" : "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><small><sup>⬤</sup></small></span>",
            "none": " ",
            "dnd-notification": "<span foreground='red'><small><sup>⬤</sup></small></span>",
            "dnd-none": " "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "escape": true,
        "tooltip": false
    }, 

    "custom/github": {
        "format": " {}",
        "tooltip-format": "GitHub Notifications",
        "return-type": "json",
        "interval": 60,
        "exec": "~/.config/waybar/scripts/github.sh",
        "on-click": "xdg-open https://github.com/notifications",
        "tooltip": true
    },

    "custom/rofi": {
        "format": "{icon} Search",
        "format-icons": [""],
        "tooltip-format": "Applications",
        "on-click": "rofi -show drun"

    },

    "custom/wl-gammarelay-temperature": {
        // wl-gammarelay-rs (not the plain wl-gammarelay this replaced)
        // exposes each output separately over D-Bus, so a desktop with
        // multiple monitors can adjust one without dragging the other along
        // -- see gammarelay-temperature.sh. exec/on-scroll below target "/",
        // the global average across every output: correct as-is for a
        // single-display machine, and each multi-monitor bar in config.jsonc
        // overrides these three keys to name its own output.
        "format": "{} {icon}",
        "format-alt": "{icon}", 
        "format-icons": [""],
        "return-type": "json",
        "interval": 2,
        "exec": "~/.config/waybar/scripts/gammarelay-temperature.sh get /",
        "on-scroll-up": "~/.config/waybar/scripts/gammarelay-temperature.sh inc /",
        "on-scroll-down": "~/.config/waybar/scripts/gammarelay-temperature.sh dec /",
        "tooltip": true
    },

    "custom/media": {
        "format": "{}",
        "escape": true,
        "return-type": "json",
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop",
        "smooth-scrolling-threshold": 10,
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "exec": "~/.config/waybar/scripts/mediaplayer.py",
        "tooltip": true,
        "tooltip-format": "{}"
    },

    "wireplumber": {
        "on-click": "pavucontrol",
        "on-click-right": "amixer sset Master toggle 1>/dev/null",
        "format": "<span foreground='#fab387'>{icon}</span> {volume}%",
        "format-muted": " ",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [" ", " ", " "]
        }
    },

    "cpu": {
        "interval": 1,
        "format": "{max_frequency}GHz <span color=\"darkgray\">| {usage}%</span>",
        "max-length": 13,
        "min-length": 13,
        "on-click": "warp-terminal --title btop sh -c 'btop'"
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.2f} / {total:0.0f} GB",
        "on-click": "warp-terminal --title btop sh -c 'btop'"
    },

    "custom/storage": {
        "format": " {}",
        "format-alt": "{percentage}% ",
        "format-alt-click": "click-right",
        "return-type": "json",
        "interval": 60,
        "exec": "~/.config/waybar/scripts/storage.sh"
    },

    "custom/weather": {
        "format": "{}",
        "format-alt": "{alt}: {}",
        "format-alt-click": "click-right",
        "interval": 3600,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/weather.sh Valladolid",
        "exec-if": "ping wttr.in -c1"
    },

    "custom/screenshot": {
        "format": "{icon}",
        "format-icons": [""],
        "tooltip-format": "Take Screenshot",
        "on-click": "grim -g \"$(slurp)\" - | satty --filename - --fullscreen --output-filename ~/Pictures/Screenshots/satty-$(date '+%Y%m%d-%H:%M:%S').png",
        "tooltip": true
    }
}
