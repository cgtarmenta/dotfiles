// Three bars, picked by the output they land on — no hostname detection
// needed, because Waybar only instantiates a bar whose "output" matches a
// monitor that is actually connected:
//
//   "!eDP-2", "!DP-4", "*"  → full bar: the desktop's ultrawide (or any other
//                             external screen), or one plugged into the
//                             laptop. Room for everything, all ten workspace
//                             numbers pinned.
//   "DP-4"                  → desktop secondary bar: the Kamvas Pro 13 tablet
//                             on MUTOMBO. No pinned workspaces (ten always-
//                             visible numbers overlap at this size), no
//                             memory/disk readouts, no raw IP in "network".
//   "eDP-2"                 → compact bar: the ROG Flow X13's internal
//                             1920x1200 panel. Same trims as DP-4 above.
//
// The trailing "*" on the exclusion entry is required, not decorative: per
// `man 5 waybar`, an "output" array of only exclusions matches nothing on its
// own — you need "*" at the end to mean "everything else". Without it Waybar
// starts, logs normally, and never creates a single bar — no error anywhere,
// it just sits idle. Confirmed live: this shipped without the "*" and left
// the desktop with no bar at all until caught.
//
// Module *definitions* are shared from modules.jsonc; each bar only picks which
// of them it shows, plus the couple of per-machine overrides below. Waybar's
// include merge is "outer file wins, recursively", so an override here only has
// to name the keys that differ — never the whole module.
[
    {
        // ── Full bar (ultrawide / external monitor) ──
        "layer": "top",
        "position": "top",
        "mod": "dock",
        "exclusive": true,
        "passthrough": false,
        "gtk-layer-shell": true,
        "output": ["!eDP-2", "!DP-4", "*"],

        "include": [
            "~/.config/waybar/modules.jsonc"
        ],

        "modules-left": [
            "custom/rofi",
            "hyprland/workspaces",
            "temperature",
            "hyprland/window"
        ],
        "modules-center": [
            "clock",
            "custom/weather"
        ],
        "modules-right": [
            "custom/storage",
            "memory",
            "cpu",
            "custom/asus_gpu_mode",
            "custom/screenshot",
            "tray",
            "custom/media",
            "group/hardware",
            "group/audio",
            "network",
            "group/exit",
            "custom/wol",
            "custom/updates",
            "custom/github",
            "custom/swaync"
        ],

        // Wide screen: keep all ten workspace numbers on the bar even when
        // empty, so their position never shifts. 11/12 are the secondary
        // screens' own workspaces.
        "hyprland/workspaces": {
            "persistent-workspaces": {
                "*": 10,
                "HDMI-A-1": [11, 12],
                "DP-1": [11, 12]
            }
        },

        // Desktop CPU sensor.
        "temperature": {
            "thermal-zone": 7
        },

        // "backlight" swapped for "custom/monitor_brightness": this is an
        // external monitor, no Linux "backlight" sysfs device applies to it.
        // --sn identifies this LG panel specifically, by its real EDID
        // serial (the Kamvas below has none, hence --model there instead).
        "group/hardware": {
            "modules": [
                "battery",
                "power-profiles-daemon",
                "custom/ac_idle_mode",
                "custom/wl-gammarelay-temperature",
                "custom/monitor_brightness"
            ]
        },
        "custom/monitor_brightness": {
            "exec": "~/.config/waybar/scripts/monitor-brightness.sh get --sn 107NTUW5C662",
            "on-scroll-up": "~/.config/waybar/scripts/monitor-brightness.sh inc --sn 107NTUW5C662",
            "on-scroll-down": "~/.config/waybar/scripts/monitor-brightness.sh dec --sn 107NTUW5C662"
        },

        // Scoped to this monitor's own wl-gammarelay-rs output object, so
        // adjusting color temperature here doesn't drag DP-4 along with it.
        "custom/wl-gammarelay-temperature": {
            "exec": "~/.config/waybar/scripts/gammarelay-temperature.sh get /outputs/DP_5",
            "on-scroll-up": "~/.config/waybar/scripts/gammarelay-temperature.sh inc /outputs/DP_5",
            "on-scroll-down": "~/.config/waybar/scripts/gammarelay-temperature.sh dec /outputs/DP_5"
        }
    },

    {
        // ── Desktop secondary bar (Kamvas Pro 13 tablet on MUTOMBO) ──
        "layer": "top",
        "position": "top",
        "mod": "dock",
        "exclusive": true,
        "passthrough": false,
        "gtk-layer-shell": true,
        "output": ["DP-4"],

        "include": [
            "~/.config/waybar/modules.jsonc"
        ],

        // No "persistent-workspaces" override: without it Waybar shows only
        // workspaces actually in use, which is what fits without the numbers
        // overlapping. Same width-saving trims as the laptop's compact bar:
        // "memory" and "custom/storage" dropped, and "network" below skips
        // printing the raw IP.
        "modules-left": [
            "custom/rofi",
            "hyprland/workspaces",
            "temperature",
            "hyprland/window"
        ],
        "modules-center": [
            "clock",
            "custom/weather"
        ],
        "modules-right": [
            "cpu",
            "custom/asus_gpu_mode",
            "custom/screenshot",
            "tray",
            "custom/media",
            "group/hardware",
            "group/audio",
            "network",
            "group/exit",
            "custom/wol",
            "custom/updates",
            "custom/github",
            "custom/swaync"
        ],

        // Same physical desktop as the full bar, same CPU sensor.
        "temperature": {
            "thermal-zone": 7
        },

        // Icon only on ethernet, no raw IP/CIDR text — same trim as the
        // laptop's compact bar below. The full bar keeps the address.
        "network": {
            "format-ethernet": " "
        },

        // "backlight" swapped for "custom/monitor_brightness" — same
        // reasoning as the full bar. The Kamvas has no usable EDID serial
        // (ddcutil detect shows a placeholder), so --model selects it
        // instead; the LG panel has a distinct model name so this can't
        // cross-match it.
        "group/hardware": {
            "modules": [
                "battery",
                "power-profiles-daemon",
                "custom/ac_idle_mode",
                "custom/wl-gammarelay-temperature",
                "custom/monitor_brightness"
            ]
        },
        "custom/monitor_brightness": {
            "exec": "~/.config/waybar/scripts/monitor-brightness.sh get --model \"Kamvas Pro 13\"",
            "on-scroll-up": "~/.config/waybar/scripts/monitor-brightness.sh inc --model \"Kamvas Pro 13\"",
            "on-scroll-down": "~/.config/waybar/scripts/monitor-brightness.sh dec --model \"Kamvas Pro 13\""
        },

        // Scoped to this monitor's own wl-gammarelay-rs output object, so
        // adjusting color temperature here doesn't drag DP-5 along with it.
        "custom/wl-gammarelay-temperature": {
            "exec": "~/.config/waybar/scripts/gammarelay-temperature.sh get /outputs/DP_4",
            "on-scroll-up": "~/.config/waybar/scripts/gammarelay-temperature.sh inc /outputs/DP_4",
            "on-scroll-down": "~/.config/waybar/scripts/gammarelay-temperature.sh dec /outputs/DP_4"
        }
    },

    {
        // ── Compact bar (ROG Flow X13 internal panel) ──
        "layer": "top",
        "position": "top",
        "mod": "dock",
        "exclusive": true,
        "passthrough": false,
        "gtk-layer-shell": true,
        "output": ["eDP-2"],

        "include": [
            "~/.config/waybar/modules.jsonc"
        ],

        // No "persistent-workspaces" override: without it Waybar shows only
        // the workspaces actually in use, which is the only thing that fits on
        // a 1920x1200 panel.
        "modules-left": [
            "custom/rofi",
            "hyprland/workspaces",
            "temperature",
            "hyprland/window"
        ],
        "modules-center": [
            "clock",
            "custom/weather"
        ],
        // Dropped vs. the full bar: "memory" and "custom/storage". Live RAM and
        // disk figures aren't worth the width here; "cpu" stays.
        "modules-right": [
            "cpu",
            "custom/asus_gpu_mode",
            "custom/screenshot",
            "tray",
            "custom/media",
            "group/hardware",
            "group/audio",
            "network",
            "group/exit",
            "custom/wol",
            "custom/updates",
            "custom/github",
            "custom/swaync"
        ],

        // This machine has no thermal_zone7 — only two acpitz zones, neither of
        // them the CPU. k10temp (Tctl) is the real package sensor. Addressed by
        // its stable sysfs device path rather than /sys/class/hwmon/hwmonN,
        // which is enumeration-order dependent.
        "temperature": {
            "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
            "input-filename": "temp1_input"
        },

        // Icon only on ethernet, no raw IP/CIDR text — same trim as the
        // desktop secondary bar above. The full bar keeps the address.
        "network": {
            "format-ethernet": " "
        }
    }
]
